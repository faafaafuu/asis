{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sufler",
  "version": "1.7.0",
  "identifier": "app.sufler.popup",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/faafaafuu/asis/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2N0VBNTM5MzkxNjUzNDMKUldSRFV4WTVPYVYrMWcxd3lYNHExeUlUeXJFNGQ3ZUxhQnBEdDMxbjBZOUM1K3FBcndHa3MrcTEK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Мультимодальная оболочка для ИИ",
    "longDescription": "Ноа — мультимодальная оболочка для ИИ: подключите любую нейросеть и соберите модуль под свою задачу за пару минут, без программирования.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
